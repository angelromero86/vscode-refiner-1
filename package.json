{
  "name": "refiner",
  "displayName": "Refiner",
  "description": "Inline comment threads (annotations) on code and on the running UI that Claude Code can read and reply to.",
  "version": "0.0.1",
  "publisher": "refiner-dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/angel/refiner.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "configuration": {
      "title": "Refiner",
      "properties": {
        "refiner.authorName": {
          "type": "string",
          "default": "",
          "description": "Name used as the author of comments you create. Defaults to your OS username."
        },
        "refiner.chromePath": {
          "type": "string",
          "default": "",
          "description": "Browser binary for 'Review UI in Browser' (Chrome, Chromium, Brave or Edge). Empty = auto-detect; the REFINER_CHROME environment variable is honored too."
        }
      }
    },
    "commands": [
      {
        "command": "refiner.createThread",
        "title": "Add Comment",
        "enablement": "!commentIsEmpty"
      },
      {
        "command": "refiner.replyThread",
        "title": "Reply",
        "enablement": "!commentIsEmpty"
      },
      {
        "command": "refiner.resolveThread",
        "title": "Resolve",
        "icon": "$(check)"
      },
      {
        "command": "refiner.reopenThread",
        "title": "Reopen",
        "icon": "$(comment-unresolved)"
      },
      {
        "command": "refiner.deleteThread",
        "title": "Delete Thread",
        "icon": "$(trash)"
      },
      {
        "command": "refiner.editComment",
        "title": "Edit",
        "icon": "$(edit)"
      },
      {
        "command": "refiner.deleteComment",
        "title": "Delete",
        "icon": "$(trash)"
      },
      {
        "command": "refiner.saveComment",
        "title": "Save",
        "enablement": "!commentIsEmpty"
      },
      {
        "command": "refiner.cancelEdit",
        "title": "Cancel"
      },
      {
        "command": "refiner.refresh",
        "title": "Reload Comments",
        "category": "Refiner",
        "icon": "$(refresh)"
      },
      {
        "command": "refiner.reanchor",
        "title": "Re-anchor Comments to Current Code",
        "category": "Refiner"
      },
      {
        "command": "refiner.installSkills",
        "title": "Install Claude Code Skills",
        "category": "Refiner"
      },
      {
        "command": "refiner.openWeb",
        "title": "Review UI in Browser…",
        "category": "Refiner",
        "icon": "$(browser)"
      },
      {
        "command": "refiner.stopWeb",
        "title": "Stop Browser Review Session",
        "category": "Refiner",
        "icon": "$(debug-stop)",
        "enablement": "refiner.webSession"
      },
      {
        "command": "refiner.webSessionMenu",
        "title": "Browser Review Session…",
        "category": "Refiner"
      },
      {
        "command": "refiner.ui.open",
        "title": "Open"
      },
      {
        "command": "refiner.ui.openSource",
        "title": "Go to Source",
        "icon": "$(go-to-file)"
      },
      {
        "command": "refiner.ui.showInBrowser",
        "title": "Show in Browser",
        "icon": "$(eye)"
      },
      {
        "command": "refiner.ui.openShot",
        "title": "Open Screenshot",
        "icon": "$(file-media)"
      },
      {
        "command": "refiner.ui.reply",
        "title": "Reply…",
        "icon": "$(reply)"
      },
      {
        "command": "refiner.ui.resolve",
        "title": "Resolve",
        "icon": "$(check)"
      },
      {
        "command": "refiner.ui.reopen",
        "title": "Reopen",
        "icon": "$(comment-unresolved)"
      },
      {
        "command": "refiner.ui.delete",
        "title": "Delete Thread",
        "icon": "$(trash)"
      }
    ],
    "viewsContainers": {
      "panel": [
        {
          "id": "refiner",
          "title": "Refiner",
          "icon": "media/refiner.svg"
        }
      ]
    },
    "views": {
      "refiner": [
        {
          "id": "refiner.uiThreads",
          "name": "UI Threads",
          "icon": "$(browser)",
          "contextualTitle": "Refiner"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "refiner.uiThreads",
        "contents": "No UI threads yet.\n[Review UI in Browser…](command:refiner.openWeb)\nChrome opens on your running app with the review overlay: press C and click any element to leave a thread. Threads land in .refiner/web-comments.json, and /refine-resolve works through them."
      }
    ],
    "menus": {
      "commandPalette": [
        { "command": "refiner.createThread", "when": "false" },
        { "command": "refiner.replyThread", "when": "false" },
        { "command": "refiner.resolveThread", "when": "false" },
        { "command": "refiner.reopenThread", "when": "false" },
        { "command": "refiner.deleteThread", "when": "false" },
        { "command": "refiner.editComment", "when": "false" },
        { "command": "refiner.deleteComment", "when": "false" },
        { "command": "refiner.saveComment", "when": "false" },
        { "command": "refiner.cancelEdit", "when": "false" },
        { "command": "refiner.webSessionMenu", "when": "refiner.webSession" },
        { "command": "refiner.ui.open", "when": "false" },
        { "command": "refiner.ui.openSource", "when": "false" },
        { "command": "refiner.ui.showInBrowser", "when": "false" },
        { "command": "refiner.ui.openShot", "when": "false" },
        { "command": "refiner.ui.reply", "when": "false" },
        { "command": "refiner.ui.resolve", "when": "false" },
        { "command": "refiner.ui.reopen", "when": "false" },
        { "command": "refiner.ui.delete", "when": "false" }
      ],
      "view/title": [
        {
          "command": "refiner.openWeb",
          "group": "navigation@1",
          "when": "view == refiner.uiThreads && !refiner.webSession"
        },
        {
          "command": "refiner.stopWeb",
          "group": "navigation@1",
          "when": "view == refiner.uiThreads && refiner.webSession"
        },
        {
          "command": "refiner.refresh",
          "group": "navigation@2",
          "when": "view == refiner.uiThreads"
        }
      ],
      "view/item/context": [
        {
          "command": "refiner.ui.openSource",
          "group": "inline@1",
          "when": "view == refiner.uiThreads && viewItem =~ /^thread-.*-source$/"
        },
        {
          "command": "refiner.ui.showInBrowser",
          "group": "inline@2",
          "when": "view == refiner.uiThreads && viewItem =~ /^thread-/"
        },
        {
          "command": "refiner.ui.resolve",
          "group": "inline@3",
          "when": "view == refiner.uiThreads && viewItem =~ /^thread-open/"
        },
        {
          "command": "refiner.ui.reopen",
          "group": "inline@3",
          "when": "view == refiner.uiThreads && viewItem =~ /^thread-resolved/"
        },
        {
          "command": "refiner.ui.reply",
          "group": "1_act@1",
          "when": "view == refiner.uiThreads && viewItem =~ /^thread-open/"
        },
        {
          "command": "refiner.ui.openSource",
          "group": "2_nav@1",
          "when": "view == refiner.uiThreads && viewItem =~ /^thread-.*-source$/"
        },
        {
          "command": "refiner.ui.showInBrowser",
          "group": "2_nav@2",
          "when": "view == refiner.uiThreads && viewItem =~ /^thread-/"
        },
        {
          "command": "refiner.ui.openShot",
          "group": "2_nav@3",
          "when": "view == refiner.uiThreads && viewItem =~ /^thread-/"
        },
        {
          "command": "refiner.ui.resolve",
          "group": "3_status@1",
          "when": "view == refiner.uiThreads && viewItem =~ /^thread-open/"
        },
        {
          "command": "refiner.ui.reopen",
          "group": "3_status@1",
          "when": "view == refiner.uiThreads && viewItem =~ /^thread-resolved/"
        },
        {
          "command": "refiner.ui.delete",
          "group": "4_danger@1",
          "when": "view == refiner.uiThreads && viewItem =~ /^thread-/"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "refiner.createThread",
          "group": "inline",
          "when": "commentController == refiner.commentController && commentThreadIsEmpty"
        },
        {
          "command": "refiner.replyThread",
          "group": "inline",
          "when": "commentController == refiner.commentController && !commentThreadIsEmpty"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "refiner.resolveThread",
          "group": "navigation",
          "when": "commentController == refiner.commentController && commentThread == open"
        },
        {
          "command": "refiner.reopenThread",
          "group": "navigation",
          "when": "commentController == refiner.commentController && commentThread == resolved"
        },
        {
          "command": "refiner.deleteThread",
          "group": "navigation",
          "when": "commentController == refiner.commentController"
        }
      ],
      "comments/comment/title": [
        {
          "command": "refiner.editComment",
          "group": "group@1",
          "when": "commentController == refiner.commentController && comment == user"
        },
        {
          "command": "refiner.deleteComment",
          "group": "group@2",
          "when": "commentController == refiner.commentController && comment == user"
        }
      ],
      "comments/comment/context": [
        {
          "command": "refiner.cancelEdit",
          "group": "inline@1",
          "when": "commentController == refiner.commentController"
        },
        {
          "command": "refiner.saveComment",
          "group": "inline@2",
          "when": "commentController == refiner.commentController"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test test/*.test.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.0",
    "typescript": "^5.4.0"
  }
}
